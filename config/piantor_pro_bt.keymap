/*
 * Piantor Pro BT - port of the Kyria "mharlin" QMK keymap (Colemak-DH, home row mods).
 * 42-key layout: three 6-column rows + 3 thumbs per side. Outer columns are unused (&none).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define NAV    1
#define MOUSE  2
#define BUTTON 3
#define NUM    4
#define SYM    5
#define FUN    6
#define MEDIA  7

// Key positions (6-column layout)
#define KEYS_L   0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R   6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS_L 36 37 38
#define THUMBS_R 39 40 41

#define REDO  &kp LG(LS(Z))
#define PASTE &kp LG(V)
#define COPY  &kp LG(C)
#define CUT   &kp LG(X)
#define UNDO  &kp LG(Z)

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    behaviors {
        // Home row mods: left hand holds trigger on right-hand keys and thumbs, and vice versa
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS_L THUMBS_R>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L THUMBS_R>;
            hold-trigger-on-release;
        };

        // Double-tap a layer key to lock into that layer (single tap does nothing)
        td_base: td_base_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to BASE>;
        };
        td_num: td_num_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to NUM>;
        };
        td_nav: td_nav_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to NAV>;
        };
        td_sym: td_sym_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to SYM>;
        };
        td_mouse: td_mouse_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to MOUSE>;
        };
        td_fun: td_fun_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to FUN>;
        };
        td_media: td_media_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to MEDIA>;
        };

        // Del/Fn: tap = Del, double-tap = F13 (Karabiner maps F13 -> Fn), hold = Fun layer
        td_del_f13: td_del_f13 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DEL>, <&kp F13>;
        };
        del_fn: del_fn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&td_del_f13>;
        };

        // Swedish letters via macOS Option+U dead key. Shifted variants release shift for the
        // dead key, then type the capital letter, then restore shift.
        a_um_mm: a_umlaut_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&a_um>, <&a_um_cap>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        o_um_mm: o_umlaut_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&o_um>, <&o_um_cap>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        a_um: a_um {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp A>;
        };
        a_um_cap: a_um_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>,
                       <&macro_tap &kp LA(U)>,
                       <&macro_tap &kp LS(A)>,
                       <&macro_press &kp LSHFT>;
        };
        o_um: o_um {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U) &kp O>;
        };
        o_um_cap: o_um_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>,
                       <&macro_tap &kp LA(U)>,
                       <&macro_tap &kp LS(O)>,
                       <&macro_press &kp LSHFT>;
        };

        // App launchers: Cmd+Space (Spotlight/Raycast), wait, type name, Enter
        app_vscode: app_vscode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 200>,
                       <&macro_tap &kp V &kp S &kp C &kp RET>;
        };
        app_intellij: app_intellij {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 200>,
                       <&macro_tap &kp I &kp N &kp T &kp E &kp L &kp L &kp I &kp J &kp RET>;
        };
        app_zen: app_zen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 200>,
                       <&macro_tap &kp Z &kp E &kp N &kp RET>;
        };
        app_ghostty: app_ghostty {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 200>,
                       <&macro_tap &kp G &kp H &kp O &kp S &kp T &kp T &kp Y &kp RET>;
        };
        app_slack: app_slack {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 200>,
                       <&macro_tap &kp S &kp L &kp A &kp C &kp K &kp RET>;
        };
        app_logseq: app_logseq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 200>,
                       <&macro_tap &kp L &kp O &kp G &kp S &kp E &kp Q &kp RET>;
        };
        app_claude: app_claude {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 200>,
                       <&macro_tap &kp C &kp L &kp A &kp U &kp D &kp E &kp RET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&none  &kp Q           &kp W           &kp F           &kp P           &kp B       &kp J  &kp L           &kp U           &kp Y           &kp SQT          &none
&none  &hml LGUI A     &hml LALT R     &hml LCTRL S    &hml LSHFT T    &kp G       &kp M  &hmr LSHFT N    &hmr LCTRL E    &hmr LALT I     &hmr LGUI O      &none
&none  &lt BUTTON Z    &hml RALT X     &kp C           &kp D           &kp V       &kp K  &kp H           &kp COMMA       &hmr RALT DOT   &lt BUTTON FSLH  &none
                                       &lt MEDIA ESC   &lt NAV SPACE   &lt MOUSE TAB   &lt SYM RET   &lt NUM BSPC   &del_fn FUN 0
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&none  &app_slack  &app_ghostty  &app_vscode  &app_intellij  &app_zen        REDO      PASTE     COPY      CUT       UNDO      &none
&none  &kp LGUI    &kp LALT      &kp LCTRL    &kp LSHFT      &app_logseq     &caps_word &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &none
&none  &none       &td_base      &td_num      &td_nav        &app_claude     &kp INS   &kp HOME  &kp PG_DN &kp PG_UP &kp END   &none
                                 &none        &none          &none           &kp RET   &kp BSPC  &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&none  &none     &none      &none      &td_base   &none     REDO     PASTE            COPY             CUT              UNDO             &none
&none  &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHFT  &none     &none    &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &none
&none  &none     &kp RALT   &td_sym    &td_mouse  &none     &none    &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT  &none
                            &none      &none      &none     &mkp MB2 &mkp MB1         &mkp MB3
            >;
        };

        button_layer {
            display-name = "Button";
            bindings = <
&none  UNDO      CUT        COPY       PASTE      REDO      REDO     PASTE     COPY      CUT       UNDO      &none
&none  &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHFT  &none     &none    &kp LSHFT &kp LCTRL &kp LALT  &kp LGUI  &none
&none  UNDO      CUT        COPY       PASTE      REDO      REDO     PASTE     COPY      CUT       UNDO      &none
                            &mkp MB3   &mkp MB1   &mkp MB2  &mkp MB2 &mkp MB1  &mkp MB3
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&none  &kp LBKT  &kp N7      &kp N8      &kp N9            &kp RBKT   &none  &td_base  &kp LA(A)  &a_um_mm  &o_um_mm   &none
&none  &kp SEMI  &kp N4      &kp N5      &hml LSHFT N6     &kp EQUAL  &none  &kp LSHFT &kp LCTRL  &sk RALT  &kp LGUI   &none
&none  &kp GRAVE &kp N1      &kp N2      &kp N3            &kp BSLH   &none  &td_num   &td_nav    &kp RALT  &none      &none
                             &kp DOT     &kp N0            &kp MINUS  &none  &none     &none
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&none  &kp LBRC   &kp AMPS   &kp STAR   &kp LPAR   &kp RBRC    &none  &td_base  &none    &none     &none  &none
&none  &kp COLON  &kp DLLR   &kp PRCNT  &kp CARET  &kp PLUS    &none  &kp LSHFT &none    &none     &none  &none
&none  &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp PIPE    &none  &td_sym   &td_mouse &kp RALT  &none  &none
                             &kp LPAR   &kp RPAR   &kp UNDER   &none  &none     &none
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN       &bt BT_SEL 0  &td_base   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
&none  &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK        &none         &kp LSHFT  &kp LCTRL     &kp LALT      &kp LGUI      &none
&none  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK &none         &td_fun    &td_media     &kp RALT      &none         &none
                                &kp K_APP  &kp SPACE  &kp TAB  &none  &none  &none
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&none  &none     &none      &none      &td_base   &none     REDO     PASTE            COPY             CUT              UNDO             &none
&none  &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHFT  &none     &none    &kp C_PREV       &kp C_VOL_DN     &kp C_VOL_UP     &kp C_NEXT       &none
&none  &none     &kp RALT   &td_sym    &td_mouse  &none     &none    &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT  &none
                            &none      &none      &none     &mkp MB2 &mkp MB1         &kp C_MUTE
            >;
        };
    };
};
